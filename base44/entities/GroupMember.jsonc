{
  "name": "GroupMember",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID del grupo"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario"
    },
    "user_nombre": {
      "type": "string",
      "description": "Nombre del usuario"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario (cache)"
    },
    "user_telefono": {
      "type": "string",
      "description": "Tel\u00e9fono del usuario"
    },
    "puntos_totales": {
      "type": "number",
      "default": 0,
      "description": "Suma de puntos obtenidos en el grupo"
    }
  },
  "required": [
    "group_id",
    "user_id"
  ]
}